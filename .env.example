# Your Firebase web app config (Project settings > General > Your apps), as JSON
# on one line, e.g. {"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","appId":"..."}
# The older devalue-serialised format is still accepted.
VITE_FIREBASE_CONFIG=

# Set to true to use the local Firebase emulators (see README).
# VITE_FIREBASE_EMULATORS=true

# Docker only. The container runs as 911; uncomment and set these to your own
# `id -u` / `id -g` if you would rather it match your host user instead of
# chowning the source to 911.
# UID=1000
# GID=1000
